# LLM provider selection: local or cloud
LLM_PROVIDER=local

# Local Ollama settings
OLLAMA_HOST=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Cloud Ollama settings (OpenAI-compatible endpoint)
# Valid cloud model available on the current endpoint: gpt-oss:20b
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
OLLAMA_CLOUD_MODEL=gpt-oss:20b

# FastAPI backend settings
API_HOST=127.0.0.1
API_PORT=9002
API_URL=http://127.0.0.1:9002

# Streamlit UI settings
STREAMLIT_HOST=127.0.0.1
STREAMLIT_PORT=8502
STREAMLIT_URL=http://127.0.0.1:8502

# Optional Gradio UI settings
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860

# Data storage settings
CHROMA_PATH=./data/chroma
SQLITE_PATH=./data/incidents.db